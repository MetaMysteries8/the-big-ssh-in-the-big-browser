{
  "manifest_version": 3,
  "name": "Big SSH Local Connector",
  "version": "0.1.0",
  "description": "Connect the Big SSH browser terminal to approved TCP destinations on your own network connection.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Big SSH connection permissions" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["http://localhost/*", "http://127.0.0.1/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
